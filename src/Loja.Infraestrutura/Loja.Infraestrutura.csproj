<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aula 1: EF Core para o CRUD/CQRS simples do Catálogo -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />

    <!-- Aulas 3-5: Marten como Event Store sobre PostgreSQL -->
    <PackageReference Include="Marten" Version="7.34.0" />
    <PackageReference Include="Marten.AspNetCore" Version="7.34.0" />

    <!-- Aula 6: Wolverine para Sagas / Process Managers -->
    <PackageReference Include="WolverineFx" Version="3.5.0" />
    <PackageReference Include="WolverineFx.Marten" Version="3.5.0" />

    <!-- Aula 7: Resiliência -->
    <PackageReference Include="Polly" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />

    <!-- Logging estruturado -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />

    <!-- AULA 1: extension AddValidatorsFromAssembly -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loja.Dominio\Loja.Dominio.csproj" />
    <ProjectReference Include="..\Loja.Aplicacao\Loja.Aplicacao.csproj" />
  </ItemGroup>

</Project>
