@host = http://localhost:5265

### =================================================================
### AULA 1 — CRUD legado vs CQRS simples
### =================================================================

# CRUD legado
GET {{host}}/api/legacy/produtos

###
POST {{host}}/api/legacy/produtos
Content-Type: application/json

{ "nome": "Camiseta CQRS", "preco": 79.9, "estoque": 10, "descontinuado": false }

# CQRS simples (MediatR)
###
POST {{host}}/api/produtos
Content-Type: application/json

{ "nome": "Notebook ES", "preco": 5499.0, "estoque": 5 }

###
GET {{host}}/api/produtos

###
GET {{host}}/api/produtos/buscar?termo=es&precoMinimo=100

### =================================================================
### AULAS 2-5 — Pedidos (Event Sourcing + CQRS + Snapshot)
### =================================================================

# Cria um pedido
###
# @name criarPedido
POST {{host}}/api/pedidos
Content-Type: application/json

{ "clienteId": "11111111-1111-1111-1111-111111111111", "emailCliente": "ana@loja.local" }

@pedidoId = {{criarPedido.response.body.id}}

# Adiciona itens
###
POST {{host}}/api/pedidos/{{pedidoId}}/itens
Content-Type: application/json

{ "produtoId": "22222222-2222-2222-2222-222222222222", "nomeProduto": "Notebook ES", "precoUnitario": 5499.0, "quantidade": 1 }

###
POST {{host}}/api/pedidos/{{pedidoId}}/itens
Content-Type: application/json

{ "produtoId": "33333333-3333-3333-3333-333333333333", "nomeProduto": "Mouse Saga", "precoUnitario": 199.9, "quantidade": 2 }

# AULA 4: Read Model inline (consistência forte)
###
GET {{host}}/api/pedidos/{{pedidoId}}

# AULA 2/4: histórico cru de eventos (auditoria nativa, time travel)
###
GET {{host}}/api/pedidos/{{pedidoId}}/historico

# AULA 5: snapshot do agregado
###
GET {{host}}/api/pedidos/{{pedidoId}}/snapshot

### =================================================================
### AULA 6 — Saga / Checkout
### =================================================================
###
# @name checkout
POST {{host}}/api/checkout/{{pedidoId}}

@correlacaoId = {{checkout.response.body.correlacaoId}}

# Inspecionar estado da saga
###
GET {{host}}/api/checkout/sagas/{{correlacaoId}}

# Dashboard global (read model assíncrono)
###
GET {{host}}/api/pedidos-dashboard

# Histórico de pedidos do cliente
###
GET {{host}}/api/clientes/11111111-1111-1111-1111-111111111111/pedidos
