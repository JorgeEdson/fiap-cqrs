    <PackageReference Include="Marten.AspNetCore" Version="7.34.0" />
    <PackageReference Include="WolverineFx.Http" Version="3.5.0" />
    <PackageReference Include="WolverineFx.Marten" Version="3.5.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loja.Dominio\Loja.Dominio.csproj" />
